# Copy to .env and fill in. docker compose reads it automatically.

# Postgres credentials. Use a password without URL-special characters (@ : / ? #),
# because it is placed inside DATABASE_URL.
POSTGRES_USER=ghumakkad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ghumakkad
POSTGRES_PORT=5432

# Host port the site is published on.
APP_PORT=3000

# Used by `npm run dev` and `npm run db:*` when running outside Docker.
DATABASE_URL=postgres://ghumakkad:change-me@localhost:5432/ghumakkad

# Login cookies are marked Secure when the request arrived over HTTPS
# (X-Forwarded-Proto from your proxy). Set to true or false to override.
# COOKIE_SECURE=true
